{
  "name": "comparative-legislative-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false && tsc -p apps/web/tsconfig.json --pretty false",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify:capabilities": "node scripts/verify_capabilities.mjs",
    "package:b1": "npm run build && node scripts/package_b1_release.mjs",
    "verify": "npm run test && npm run verify:capabilities && npm run package:b1"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "fastify": "5.11.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
