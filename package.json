{
  "name": "comparative-legislative-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --force --pretty false && tsc -p apps/web/tsconfig.json --pretty false",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check:docs": "node scripts/check_doc_links.mjs",
    "verify:capabilities": "node scripts/verify_capabilities.mjs && node scripts/verify_db1_foundation.mjs",
    "package:b1": "npm run build && node scripts/package_b1_release.mjs",
    "verify": "npm run test && npm run verify:capabilities && npm run package:b1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.2",
    "argon2": "^0.44.0",
    "fastify": "5.11.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
