[Unit]
Description=Comparative Legislative Data DB1 D4A reference reconciliation

[Service]
Type=oneshot
User=cld-gb-sct
Group=cld-gb-sct
WorkingDirectory=/srv/cld-gb-sct/releases/RELEASE_ID
EnvironmentFile=/etc/cld-gb-sct/secrets/db1-d4a.env
ExecStart=/srv/cld-gb-sct/runtime/node-v24.18.1/bin/node scripts/run_db1_d4_reference_reconciliation.mjs
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/cld-gb-sct/raw/db1 /srv/cld-gb-sct/state
CPUQuota=20%
MemoryMax=256M
TasksMax=64
