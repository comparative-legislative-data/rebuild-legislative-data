[Unit]
Description=Comparative Legislative Data DB1 full-scope Run B MQA collections

[Service]
Type=oneshot
User=cld-gb-sct
WorkingDirectory=/srv/cld-gb-sct/releases/__CLD_RELEASE__
EnvironmentFile=/etc/cld-gb-sct/secrets/db1-fullscope.env
Environment=CLD_RELEASE_ID=__CLD_RELEASE__
ExecStart=/srv/cld-gb-sct/runtime/node-v24.18.1/bin/node scripts/run_db1_full_scope_mqa_collections.mjs
TimeoutStartSec=12h
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/cld-gb-sct/raw/db1 /srv/cld-gb-sct/state
CPUQuota=35%
MemoryMax=768M
TasksMax=128
